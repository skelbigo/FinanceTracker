# FinanceTracker local environment
#
# 1) Copy this file to .env:
#    cp env.example .env
# 2) Start with Docker (without Redis):
#    docker compose up --build
# 3) Start with Redis cache (optional):
#    docker compose --profile cache up --build

# App
APP_ENV=dev
APP_PORT=8080
GIN_MODE=debug

# Cookies / CSRF (cookies-auth stage)
# - COOKIE_SECURE=true only in prod (HTTPS)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CSRF secret should be separate from JWT_SECRET
CSRF_SECRET=change_me_dev
CSRF_TTL_MINUTES=120

# Database (preferred: DB_URL OR parts below)
DB_URL=postgres://financetracker:financetracker@localhost:5432/financetracker?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=financetracker
DB_PASSWORD=financetracker
DB_NAME=financetracker
DB_SSLMODE=disable

# Redis (optional)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0

# Analytics cache TTL (minutes)
ANALYTICS_CACHE_TTL_MINUTES=20

# Example for Docker Compose + profile "cache":
# REDIS_ENABLED=true
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Auth
JWT_SECRET=change_me_in_dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

AUTH_REFRESH_COOKIE=true

# Encryption at rest (AES-256-GCM)
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1

# Password hashing (bcrypt)
BCRYPT_COST=12

# Brute-force protection (login rate limit)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_PER_IP=20
LOGIN_RATE_LIMIT_MAX_PER_EMAIL=10

# Reverse proxy / TLS termination
TRUST_PROXY=false
TRUSTED_PROXIES=127.0.0.1,::1

## Email (SMTP)
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@financetracker.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Metrics / Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
LOG_LEVEL=info

# Feature flags
BUDGETS_ENFORCE_EXPENSE_CATEGORIES=true

# Public URL for emails
APP_PUBLIC_URL=http://localhost:8080

## Email notification rules
EMAIL_NOTIFY_OVERSPENDING=true
EMAIL_NOTIFY_NEW_TRANSACTION=false

## Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
WORKER_MAX_ATTEMPTS=5
