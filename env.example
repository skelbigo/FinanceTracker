# FinanceTracker local environment
#
# 1) Copy this file to .env:
#    cp env.example .env
# 2) Start with Docker (without Redis):
#    docker compose up --build
# 3) Start with Redis cache (optional):
#    docker compose --profile cache up --build

# App
APP_ENV=dev
APP_PORT=8080
GIN_MODE=debug

# Cookies / CSRF (cookies-auth stage)
# - COOKIE_SECURE=true only in prod (HTTPS)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CSRF secret should be separate from JWT_SECRET
CSRF_SECRET=change_me_dev
CSRF_TTL_MINUTES=120

# Database (preferred: DB_URL OR parts below)
DB_URL=postgres://financetracker:financetracker@localhost:5432/financetracker?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=financetracker
DB_PASSWORD=financetracker
DB_NAME=financetracker
DB_SSLMODE=disable

# Redis (optional)
# - run: docker compose --profile cache up --build
# - set: REDIS_ENABLED=true and REDIS_HOST/REDIS_PORT as shown below.
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0

# Analytics cache TTL (minutes)
ANALYTICS_CACHE_TTL_MINUTES=20

# Example for Docker Compose + profile "cache":
# REDIS_ENABLED=true
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Auth
JWT_SECRET=change_me_in_dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# TLS / Reverse proxy
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

## Email (SMTP)
# To test locally with MailHog:
#   docker compose --profile mail up --build
#   EMAIL_ENABLED=true
#   SMTP_HOST=mailhog
#   SMTP_PORT=1025
#   SMTP_TLS=false
#   Open MailHog UI: http://localhost:8025
#
# Email delivery is processed by a separate worker:
#   make worker
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@financetracker.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Metrics / Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
LOG_LEVEL=info

# Feature flags
BUDGETS_ENFORCE_EXPENSE_CATEGORIES=true

# Public URL for emails (links back to the app)
APP_PUBLIC_URL=http://localhost:8080

## Email notification rules
# overspending: sent immediately when EMAIL_ENABLED=true
# new_transaction: in-app only by default; if enabled, email is sent to workspace owners only
EMAIL_NOTIFY_OVERSPENDING=true
EMAIL_NOTIFY_NEW_TRANSACTION=false

## Worker (email delivery)
# Polling settings for cmd/worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
WORKER_MAX_ATTEMPTS=5

## Worker (scheduler)
# Poll DB for pending deliveries
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
WORKER_MAX_ATTEMPTS=5
